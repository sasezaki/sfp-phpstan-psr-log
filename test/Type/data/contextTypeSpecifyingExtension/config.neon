
includes:
	- ../../../../parametersSchema.neon

parameters:
	sfpPsrLog:
		enableContextRequireExceptionKeyRule: false
		enableMessageStaticStringRule: true
		reportContextExceptionLogLevel: 'debug'
		contextKeyOriginalPattern: null
		analyser:
			bigQuery:
				schemaFile: test/Type/data/contextTypeSpecifyingExtension/bigQuerySchema.json
		type:
			contextTypeSpecifyingExtension:
				enabled: true

services:
	-
		class: Sfp\PHPStan\Psr\Log\Type\ContextTypeSpecifyingExtension
		arguments:
			enabled: %sfpPsrLog.type.contextTypeSpecifyingExtension.enabled%
		tags:
			- phpstan.typeSpecifier.methodTypeSpecifyingExtension

	# BigQuery
	-
		class: Sfp\PHPStan\Psr\Log\Analyser\BigQuery\GenericTableFieldSchemaJsonPayloadTypeConverter

	-
		class: Sfp\PHPStan\Psr\Log\Analyser\BigQuery\ContextTypeWithTableFieldSchemaJsonFileProvider
		arguments:
			schemaFile: %sfpPsrLog.analyser.bigQuery.schemaFile%
